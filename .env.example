# Database connection string from Supabase: Connect -> Session pooler.
# Keep sslmode=require. Never expose this value to browser code.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres?sslmode=require

# Required when AI processing is enabled.
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_DEEP_MODEL=gpt-5.6-sol
OPENAI_FAST_REASONING_EFFORT=none
OPENAI_DEEP_REASONING_EFFORT=medium

# Configurable token prices used only for debug cost estimates (USD / 1M tokens).
OPENAI_FAST_INPUT_COST_PER_MILLION=0.20
OPENAI_FAST_OUTPUT_COST_PER_MILLION=1.20
OPENAI_DEEP_INPUT_COST_PER_MILLION=4.00
OPENAI_DEEP_OUTPUT_COST_PER_MILLION=20.00

# Free key from https://openalex.org/settings/api
OPENALEX_API_KEY=
OPENALEX_MATCH_THRESHOLD=0.90

# Pipeline limits. These are deliberately conservative for the first live run.
ARXIV_LOOKBACK_HOURS=72
ARXIV_MAX_RESULTS_PER_QUERY=300
ARXIV_DISCOVERY_MODE=rss
MAX_SOL_STORIES_PER_DAY=6
PROCESS_MAX_PAPERS=60
SOL_MAX_INPUT_TOKENS=18000
PROMPT_VERSION=story-v1

# United States + Europe hard filter. ISO 3166-1 alpha-2, comma separated.
ALLOWED_COUNTRY_CODES=US,AL,AD,AT,BE,BG,BA,BY,CH,CY,CZ,DE,DK,EE,ES,FI,FR,GB,GR,HR,HU,IE,IS,IT,LI,LT,LU,LV,MC,MD,ME,MK,MT,NL,NO,PL,PT,RO,RS,SE,SI,SK,SM,UA,VA

# Explainable ranking weights.
RANK_GLOBAL_WEIGHT=0.55
RANK_PERSONAL_WEIGHT=0.30
RANK_FRESHNESS_WEIGHT=0.10
RANK_CONFIDENCE_WEIGHT=0.05

# The browser only receives these public Supabase values. Add them to Vercel later.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
